// NHWC [1,H,W,C] → NCHW [1,C,H,W]（1D 平坦索引）
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
layout(push_constant) uniform PC {
    uint in_off; uint out_off; uint C; uint H; uint W;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;  // NHWC 输入平坦下标
    uint total = pc.H * pc.W * pc.C;
    if (idx >= total) return;
    uint c = idx % pc.C;
    uint hw = idx / pc.C;
    uint w = hw % pc.W;
    uint h = hw / pc.W;
    data[pc.out_off + c * pc.H * pc.W + h * pc.W + w] = data[pc.in_off + idx];
}
