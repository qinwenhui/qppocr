// 同形二元 add：广播语义见 mul.comp 家族说明（同形 = 无广播）。
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
layout(push_constant) uniform PC { uint a_off; uint b_off; uint out_off; uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    data[pc.out_off + i] = data[pc.a_off + i] + data[pc.b_off + i];
}
