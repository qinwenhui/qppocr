// 空间均值阶段 2：scratch[mBlocks][Cpad] f32 → gate[Cpad]（f32 vec4 写）。
// 通道按 256 分组跨步（Cpad 可 > 256，如 small 的 SE 通道 384）：
// 每组全 WG 并行累加 + 经共享内存拼 vec4 写出（直接读改写 vec4 有跨
// 线程 lane 竞争）。组数 = ceil(Cpad/256) 是 WG 一致值——组内 barrier
// 合法；Cpad %4==0 且组界 4 对齐（分配保证），末组的 vec4 不越界。
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer F32 { float data[]; };
layout(std430, binding = 1) buffer Params { uint params[]; };
layout(std430, binding = 2) buffer D32 { vec4 d[]; };
layout(push_constant) uniform PC { uint p_off; } pc;

shared float accs[256];

void main() {
    uint P = pc.p_off;
    uint scratch_off = params[P + 0], out_off = params[P + 1];
    uint mBlocks = params[P + 2], cDim = params[P + 3], mDim = params[P + 4];

    uint lid = gl_LocalInvocationID.x;
    uint nb_idx = gl_GlobalInvocationID.x / 256u; // grid.x=nb，每 WG 一批
    if (params[0] != 0u && nb_idx >= params[0]) return; // real_n 早退：批维补齐的空行零算力；0=不限（裸 dispatch 安全默认）
    for (uint c0 = 0u; c0 < cDim; c0 += 256u) {
        uint c = c0 + lid;
        float acc = 0.0;
        if (c < cDim) {
            for (uint b = 0u; b < mBlocks; b++) {
                acc += data[scratch_off + (nb_idx * mBlocks + b) * cDim + c];
            }
        }
        accs[lid] = acc;
        barrier();
        // 每 4 通道一线程拼 vec4 写出（cDim 为 %4 对齐——分配保证）
        if (lid % 4u == 0u && c0 + lid + 4u <= cDim) {
            vec4 v = vec4(accs[lid], accs[lid + 1u], accs[lid + 2u], accs[lid + 3u]);
            d[(out_off >> 2) + nb_idx * (cDim >> 2) + ((c0 + lid) >> 2)] =
                vec4(v / float(mDim));
        }
        barrier();
    }
}
