// 1x1 conv 的 GEMM（寄存器分块版）：C[M,HW] = A[M,Ci] × B[Ci,HW]。
//
// 每线程 2×2 输出（寄存器累加）：4 load + 4 FMA / k 步（朴素版 2 load
// + 1 FMA）——FLOP:load 从 1:2 → 1:1，内存流量减半。
// local (8,8)=64 线程，workgroup tile 16×16。
//
// 适用：kh=kw=1, sh=sw=1, ph=pw=0, group=1, N=1。
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
layout(std430, binding = 1) buffer Params { uint params[]; };
layout(push_constant) uniform PC { uint p_off; } pc;

const uint NONE = 0xFFFFFFFFu;

float erf1(float x) {
    float ax = abs(x);
    float t = 1.0 / fma(0.3275911, ax, 1.0);
    float p = 1.0614054;
    p = fma(p, t, -1.453152027);
    p = fma(p, t, 1.421413741);
    p = fma(p, t, -0.284496736);
    p = fma(p, t, 0.2548296);
    p *= t;
    float xx = clamp(-ax * ax, -88.0, 88.0);
    float kf = roundEven(xx * 1.442695);
    float r = fma(-kf, 0.6931472, xx);
    r = fma(-kf, -2.9802322e-8, r);
    float q = 1.0 / 720.0;
    q = fma(q, r, 1.0 / 120.0);
    q = fma(q, r, 1.0 / 24.0);
    q = fma(q, r, 1.0 / 6.0);
    q = fma(q, r, 0.5);
    q = fma(q, r, 1.0);
    q = fma(q, r, 1.0);
    float e = uintBitsToFloat(uint(int(kf) + 127) << 23) * q;
    float res = fma(-p, e, 1.0);
    return uintBitsToFloat(floatBitsToUint(res) | (floatBitsToUint(x) & 0x80000000u));
}

void main() {
    uint P = pc.p_off;
    uint in_off = params[P + 0], w_off = params[P + 1];
    uint b_off = params[P + 2], r_off = params[P + 3], out_off = params[P + 4];
    uint Ci = params[P + 6];
    uint M = params[P + 9];
    uint HW = params[P + 21];
    uint act = params[P + 17];
    float c1 = uintBitsToFloat(params[P + 18]);
    float c2 = uintBitsToFloat(params[P + 19]);
    float c3 = uintBitsToFloat(params[P + 20]);

    uint ty = gl_LocalInvocationID.y;
    uint tx = gl_LocalInvocationID.x;
    // 2×2 寄存器分块：线程 (ty,tx) 管输出 (gm0/gm1, gn0/gn1)
    uint gm0 = gl_WorkGroupID.y * 16 + ty * 2;
    uint gm1 = gm0 + 1;
    uint gn0 = gl_WorkGroupID.x * 16 + tx * 2;
    uint gn1 = gn0 + 1;

    float acc00 = 0.0, acc01 = 0.0, acc10 = 0.0, acc11 = 0.0;

    for (uint k = 0; k < Ci; k++) {
        float a0 = (gm0 < M) ? data[w_off + gm0 * Ci + k] : 0.0;
        float a1 = (gm1 < M) ? data[w_off + gm1 * Ci + k] : 0.0;
        float b0 = (gn0 < HW) ? data[in_off + k * HW + gn0] : 0.0;
        float b1 = (gn1 < HW) ? data[in_off + k * HW + gn1] : 0.0;
        acc00 = fma(a0, b0, acc00);
        acc01 = fma(a0, b1, acc01);
        acc10 = fma(a1, b0, acc10);
        acc11 = fma(a1, b1, acc11);
    }

    // epilogue + 写 4 输出（bias/act/residual 与 conv.comp 同序）
    if (gm0 < M && gn0 < HW) {
        float v = acc00;
        if (b_off != NONE) v += data[b_off + gm0];
        if (act == 2) v = max(v, 0.0);
        else if (act == 1) { float inv = 1.0/c1; v = c3 * v * (erf1(v * inv) + c2); }
        if (r_off != NONE) v += data[r_off + gm0 * HW + gn0];
        data[out_off + gm0 * HW + gn0] = v;
    }
    if (gm0 < M && gn1 < HW) {
        float v = acc01;
        if (b_off != NONE) v += data[b_off + gm0];
        if (act == 2) v = max(v, 0.0);
        else if (act == 1) { float inv = 1.0/c1; v = c3 * v * (erf1(v * inv) + c2); }
        if (r_off != NONE) v += data[r_off + gm0 * HW + gn1];
        data[out_off + gm0 * HW + gn1] = v;
    }
    if (gm1 < M && gn0 < HW) {
        float v = acc10;
        if (b_off != NONE) v += data[b_off + gm1];
        if (act == 2) v = max(v, 0.0);
        else if (act == 1) { float inv = 1.0/c1; v = c3 * v * (erf1(v * inv) + c2); }
        if (r_off != NONE) v += data[r_off + gm1 * HW + gn0];
        data[out_off + gm1 * HW + gn0] = v;
    }
    if (gm1 < M && gn1 < HW) {
        float v = acc11;
        if (b_off != NONE) v += data[b_off + gm1];
        if (act == 2) v = max(v, 0.0);
        else if (act == 1) { float inv = 1.0/c1; v = c3 * v * (erf1(v * inv) + c2); }
        if (r_off != NONE) v += data[r_off + gm1 * HW + gn1];
        data[out_off + gm1 * HW + gn1] = v;
    }
}
