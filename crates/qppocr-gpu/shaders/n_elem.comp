// NHWC-f32 逐元素族：op 由参数块给出（0=relu 1=sigmoid 2=hardsigmoid
// 3=clip 4=add 5=mul 6=标量add 7=标量mul 8=减行向量 9=square
// 10=sqrt 11=除行向量 12=sub 13=div）。vec4 一次 4 元素，f32 计算。
// 布局：op, in_off, in2_off, out_off, n, p1(f32bits), p2(f32bits)
//（in2 仅双目用；hardsigmoid p1=alpha p2=beta；clip p1=min p2=max；
//  行向量广播 8/11 的 p1 = 每行 vec4 数 c4 的位型——b 是 [rows,4]
//  存储、只有 lane0 有效，行内 4 通道同减/除该值——LN 的 x-mean 与
//  (x-mean)/std 用）。
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 1) buffer Params { uint params[]; };
layout(std430, binding = 0) buffer D32 { vec4 d[]; };
layout(push_constant) uniform PC { uint p_off; } pc;

const uint OFF_NONE = 0xFFFFFFFFu;

void main() {
    uint P = pc.p_off;
    uint op = params[P + 0];
    uint in_off = params[P + 1], in2_off = params[P + 2], out_off = params[P + 3];
    uint n = params[P + 4];
    float p1 = uintBitsToFloat(params[P + 5]);
    float p2 = uintBitsToFloat(params[P + 6]);

    uint nv = n >> 2;
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= nv) return;
    uint ib = in_off >> 2;

    if (op == 6u || op == 7u) { // 标量广播（cls 的 Mul([1,C,1,1],[1])）
        vec4 a = vec4(d[ib + gid]);
        vec4 sv = vec4(d[(in2_off >> 2)]); // 标量在 lane0（旁 lane 是分配对齐垃圾）
        d[(out_off >> 2) + gid] = vec4(op == 6u ? a + sv.x : a * sv.x);
    } else if (op == 4u) { // add
        vec4 a = vec4(d[ib + gid]), b = vec4(d[(in2_off >> 2) + gid]);
        d[(out_off >> 2) + gid] = vec4(a + b);
    } else if (op == 5u) { // mul
        vec4 a = vec4(d[ib + gid]), b = vec4(d[(in2_off >> 2) + gid]);
        d[(out_off >> 2) + gid] = vec4(a * b);
    } else if (op == 12u) { // sub
        vec4 a = vec4(d[ib + gid]), b = vec4(d[(in2_off >> 2) + gid]);
        d[(out_off >> 2) + gid] = vec4(a - b);
    } else if (op == 13u) { // div
        vec4 a = vec4(d[ib + gid]), b = vec4(d[(in2_off >> 2) + gid]);
        d[(out_off >> 2) + gid] = vec4(a / b);
    } else if (op == 8u || op == 11u) { // 行向量广播 sub/div（LN 链）
        uint c4 = floatBitsToUint(p1);
        uint row = gid / c4;
        vec4 a = vec4(d[ib + gid]);
        float s = d[(in2_off >> 2) + row * 4u].x; // [rows,4] 的 lane0
        d[(out_off >> 2) + gid] =
            vec4(op == 8u ? a - vec4(s) : a / vec4(s));
    } else {
        vec4 a = vec4(d[ib + gid]);
        if (op == 0u) a = max(a, vec4(0.0));
        else if (op == 1u) a = 1.0 / (1.0 + exp(-a));
        else if (op == 2u) a = clamp(a * p1 + p2, vec4(0.0), vec4(1.0));
        else if (op == 9u) a = a * a;          // square（Pow 常量 2，LN 方差）
        else if (op == 10u) a = sqrt(a);       // LN 的 std
        else a = clamp(a, vec4(p1), vec4(p2)); // clip
        d[(out_off >> 2) + gid] = vec4(a);
    }
}
