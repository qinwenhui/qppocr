// clip：镜像 arch::clip_seg（逐位一致）。
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
layout(push_constant) uniform PC {
    uint in_off; uint out_off; uint n;
    float lo; float hi;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float v = data[pc.in_off + i];
    data[pc.out_off + i] = v < pc.lo ? pc.lo : (v > pc.hi ? pc.hi : v);
}
