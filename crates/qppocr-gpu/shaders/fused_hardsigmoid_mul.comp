// 融合 SE（hardsigmoid 型，hard-swish 门）：out = a * hardsigmoid(g[C])。
// 公式同 hardsigmoid.comp。
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
layout(push_constant) uniform PC {
    uint a_off; uint g_off; uint out_off;
    uint hw; uint c;
    float alpha; float beta;
} pc;
void main() {
    uint j = gl_GlobalInvocationID.x;
    uint ch = gl_GlobalInvocationID.y;
    uint n = gl_GlobalInvocationID.z;
    if (j >= pc.hw) return;
    uint base = n * pc.c * pc.hw + ch * pc.hw + j;
    float v = data[pc.g_off + ch] * pc.alpha + pc.beta;
    v = v < 0.0 ? 0.0 : (v > 1.0 ? 1.0 : v);
    data[pc.out_off + base] = data[pc.a_off + base] * v;
}
