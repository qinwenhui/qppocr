// f32 → f16 packed 转换（naga bug workaround：不用用户函数）。
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { uint data[]; };
layout(push_constant) uniform PC { uint in_off; uint out_off; uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n / 2) return;
    float a = uintBitsToFloat(data[pc.in_off + i * 2]);
    float b = uintBitsToFloat(data[pc.in_off + i * 2 + 1]);
    data[pc.out_off / 2 + i] = packHalf2x16(vec2(a, b));
}
