// ConvTranspose 2x2 s2 p0（内核同款限制——planner 已保证）。权重
// [C_in, M, 2, 2]。CPU 的「每个输出恰好赋值一次」= 内层把 Σ_ci 累加完
// 一次写出——这里镜像：每线程一个**输出**像素，跨 ci 累加。
// 输出 (co, oy, ox)：iy=oy>>1, ky=oy&1, ix=ox>>1, kx=ox&1。
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
layout(std430, binding = 1) buffer Params { uint params[]; };
layout(push_constant) uniform PC { uint p_off; } pc;

void main() {
    uint P = pc.p_off;
    uint in_off = params[P + 0], w_off = params[P + 1], out_off = params[P + 2];
    uint n = params[P + 3], ci = params[P + 4], h = params[P + 5], w = params[P + 6];
    uint m = params[P + 7];

    uint ox = gl_GlobalInvocationID.x, oy = gl_GlobalInvocationID.y;
    uint bn_co = gl_GlobalInvocationID.z;   // n * m
    if (ox >= 2u * w || oy >= 2u * h) return;
    uint bn = bn_co / m, co = bn_co % m;
    uint iy = oy >> 1, ky = oy & 1u;
    uint ix = ox >> 1, kx = ox & 1u;

    float acc = 0.0;
    for (uint c = 0; c < ci; c++) {
        // 权重 [ci, m, 2, 2]；输入 [n, ci, h, w]
        float wv = data[w_off + (((c * m + co) * 2 + ky) * 2 + kx)];
        float xv = data[in_off + (bn * ci + c) * h * w + iy * w + ix];
        acc += xv * wv;
    }
    uint ow = 2u * w;
    data[out_off + (bn * m + co) * (2u * h) * ow + oy * ow + ox] = acc;
}
