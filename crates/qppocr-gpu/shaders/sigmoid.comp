// sigmoid：y = 1/(1+exp1(-x))。exp1 是 kernels::activation::exp1 的
// 逐字镜像（范围归约 + 7 项 Horner + 指数位拼接）——与 CPU 位级一致。
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
layout(push_constant) uniform PC { uint in_off; uint out_off; uint n; } pc;

float exp1(float x) {
    const float LN2_HI = 0.6931472;
    const float LN2_LO = -2.9802322e-8;
    const float INV_LN2 = 1.442695;
    x = clamp(x, -88.0, 88.0);
    float kf = roundEven(x * INV_LN2);
    float r = fma(-kf, LN2_HI, x);
    r = fma(-kf, LN2_LO, r);
    float p = 1.0 / 720.0;
    p = fma(p, r, 1.0 / 120.0);
    p = fma(p, r, 1.0 / 24.0);
    p = fma(p, r, 1.0 / 6.0);
    p = fma(p, r, 0.5);
    p = fma(p, r, 1.0);
    p = fma(p, r, 1.0);
    int ki = int(kf) + 127;
    return uintBitsToFloat(uint(ki) << 23) * p;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    data[pc.out_off + i] = 1.0 / (1.0 + exp1(-data[pc.in_off + i]));
}
