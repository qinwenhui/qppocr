// sigmoid：y = 1/(1+exp(-x))。公式镜像 kernels/activation.rs::sigmoid_tensor
//（CPU 用 exp1 多项式，GPU 用硬件 exp——判据是容差对拍，非逐位）。
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Buf { float data[]; };
layout(push_constant) uniform PC { uint in_off; uint out_off; uint n; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    data[pc.out_off + i] = 1.0 / (1.0 + exp(-data[pc.in_off + i]));
}
