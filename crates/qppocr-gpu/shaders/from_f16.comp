// f16 packed → f32 转换。
#version 450
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Buf { uint data[]; };
layout(push_constant) uniform PC { uint in_off; uint out_off; uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n / 2) return;
    vec2 f = unpackHalf2x16(data[pc.in_off / 2 + i]);
    data[pc.out_off + i * 2] = floatBitsToUint(f.x);
    data[pc.out_off + i * 2 + 1] = floatBitsToUint(f.y);
}
